# ===== SignalBridge - configurazione motore =====
# Rinomina questo file in ".env" e compila i valori.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=incolla_qui_la_service_role_key

# https://my.telegram.org > API development tools
TG_API_ID=1234567
TG_API_HASH=incolla_qui_api_hash

# https://aistudio.google.com/apikey  (opzionale ma consigliato)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MT5: lascia vuoto per usare il conto gia' loggato nel terminale
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# 1 = MT5 finto per prove (NON usare sulla VPS)
SIMULATE=0
