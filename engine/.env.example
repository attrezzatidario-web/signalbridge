# ===== SignalBridge - configurazione =====
# Questo file si chiama ".env" e resta SOLO sulla VPS (mai su GitHub).

# Password per entrare nell'app (almeno 10 caratteri, inventala lunga)
APP_PASSWORD=

# Indirizzo dell'app (DuckDNS), es: signalbridge-dario.duckdns.org
DOMAIN=

# https://my.telegram.org > API development tools
TG_API_ID=
TG_API_HASH=

# https://aistudio.google.com/apikey  (consigliato)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MT5: lascia vuoto per usare il conto gia' loggato nel terminale
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
